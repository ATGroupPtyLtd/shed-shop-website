{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shed-shop-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
  },
  "vars": {
    // Replace this value with the site key from your Cloudflare Turnstile widget.
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_YOUR_TURNSTILE_SITE_KEY",
  },
  "send_email": [
    {
      "name": "QUOTE_EMAIL",
      "destination_address": "admin@shed-shop.com.au",
      "allowed_sender_addresses": ["website@shed-shop.com.au"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
