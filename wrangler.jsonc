{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shed-shop-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFAmwiS02a6R_4xv"
  },
  "secrets": {
    "required": [
      "RESEND_API_KEY",
      "TURNSTILE_SECRET"
    ],
  },
  "ratelimits": [
    {
      "name": "QUOTE_RATE_LIMITER",
      "namespace_id": "4170101",
      "simple": {
        "limit": 5,
        "period": 60
      },
    },
    {
      "name": "QUOTE_GLOBAL_RATE_LIMITER",
      "namespace_id": "4170102",
      "simple": {
        "limit": 30,
        "period": 60
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
}